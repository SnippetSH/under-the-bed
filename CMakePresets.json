{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022"
    },
    {
      "name": "ci",
      "displayName": "CI (warnings as errors)",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": { "SIM_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "godot",
      "displayName": "Godot GDExtension (sim-godot + godot-cpp)",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/godot",
      "cacheVariables": { "SIM_BUILD_GODOT": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "ci", "configurePreset": "ci", "configuration": "Release" },
    { "name": "godot-debug", "configurePreset": "godot", "configuration": "Debug" },
    { "name": "godot-release", "configurePreset": "godot", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "godot",
      "configurePreset": "godot",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
